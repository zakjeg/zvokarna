<Window x:Class="xamlPianoRoll.View.popupSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:xamlPianoRoll.View"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Title="popupSettings" Height="400" Width="600"
        Background="Transparent" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown" >

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                            CornerRadius="5"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="LightGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" 
                    CornerRadius="5"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- obroba da se je okno opazno tudi na istobarvni podlagi-->
    <Border CornerRadius="12" Background="#333333" BorderBrush="#555" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.4" BlurRadius="10" ShadowDepth="0" />
        </Border.Effect>
        <Border.Clip>
            <RectangleGeometry RadiusX="12" RadiusY="12" Rect="0,0,600,400"/>
        </Border.Clip>
        
        <Grid>
            
            <!-- definiranje vrstic in stolpcev (višina in širina) -->
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            
            <!-- osnovni gumbi (zapri in minimiziraj) -->

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="btnMinimize" Content="_" Width="40" Height="40" BorderBrush="Transparent" Background="Transparent" Foreground="White" Click="btnMinimize_Click"/>

                <Button Name="btnClose" Content="X" Width="40" Height="40   " BorderBrush="Transparent" Background="Transparent" Click="btnClose_Click" Foreground="White"/>
            </StackPanel>
            

            <!-- nastavitve (leva)  -->
            <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Nastavitve" FontSize="24" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,50"/>


                    <StackPanel Orientation="Horizontal" Margin="10">
                        <TextBlock Text="Št. not na takt:" Foreground="White" VerticalAlignment="Center"/>
                        <Slider Name="sliderNotesPerBeat" Margin="10" Minimum="2" Maximum="8" Width="150" Value="3" ValueChanged="Slider_ValueChanged" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Name="sliderNotesPerBeatValue" Text="3" Foreground="White" VerticalAlignment="Center" Margin="10"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="10">
                        <TextBlock Text="Št. taktov:" Margin="0,0,25,0" Foreground="White" VerticalAlignment="Center"/>
                        <Slider Name="sliderBeats" Margin="10" Minimum="2" Maximum="8" Width="150" Value="4" ValueChanged="Slider_ValueChanged" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Name="sliderBeatsValue" Text="4" Foreground="White" VerticalAlignment="Center" Margin="10"/>
                    </StackPanel>

                    <Button Content="Nastavi" Click="nastavi_Click" Width="100" Height="30"  Style="{StaticResource RoundedButtonStyle}" Background="Transparent" Foreground="White" Margin="10"/>
            </StackPanel>

            
            <!-- izvoz datoteke (desna) -->
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top">

                    <TextBlock Margin="0,55" Text="Izvoz datoteke" FontSize="24" Foreground="White" HorizontalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Margin="10">
                        <TextBlock Text="Št. ponovitev:" Margin="0,0,5,0" Foreground="White" VerticalAlignment="Center"/>
                        <Slider Name="repeatSlider" Margin="10" Minimum="1" Maximum="8" Width="100" Value="2" ValueChanged="Slider_ValueChanged" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Name="repeatSliderValue" Text="2" Foreground="White" VerticalAlignment="Center" Margin="10"/>
                    </StackPanel>


                    <StackPanel Orientation="Horizontal" Margin="10">
                        <TextBlock Text="BPM:" Margin="25,0,20,0" Foreground="White" VerticalAlignment="Center"/>
                        <Slider Name="BPMSlider" Margin="10" Minimum="60" Maximum="600" Width="100" Value="200" ValueChanged="Slider_ValueChanged" TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <TextBlock Name="BPMSliderValue" Text="200" Foreground="White" VerticalAlignment="Center" Margin="10"/>
                    </StackPanel>

                    <ToggleButton x:Name="RepeatLastToneButton" 
                      Width="100" 
                      Height="30" 
                      Content="Ponovi zadnji ton" 
                      Style="{StaticResource RoundedToggleButtonStyle}" 
                      Background="Transparent" 
                      Foreground="White" 
                      Margin="10"
                      Checked="RepeatLastTone_Checked"
                      Unchecked="RepeatLastToneButton_Unchecked"/>

                    <Button Width="100" Height="30" Content="Izvozi" Click="export_Click" Style="{StaticResource RoundedButtonStyle}" Background="Transparent" Foreground="White" Margin="10"/>
            
            </StackPanel>
        
        
        

        </Grid>
    </Border>
</Window>
