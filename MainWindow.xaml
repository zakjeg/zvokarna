<Window x:Class="xamlPianoRoll.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:xamlPianoRoll"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        
        mc:Ignorable="d" Background="#333333" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Title="MainWindow" Height="720" Width="1280">
    <!-- prilagojeni stili za različne elemente da se stilovsko ujemajo -->
    <Window.Resources>
        <local:BlackToBackgroundCOnverter x:Key="BlackKeyConverter" />

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="35" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="5,0,5,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                            CornerRadius="5"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="LightGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" 
                            CornerRadius="5"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedSetterButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                        CornerRadius="5"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="LightGray"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="T" Command="{Binding AddTrackCommand}" />
        <KeyBinding Modifiers="Control" Key="N" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveProjectCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid>
        
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <!-- razširitveni meni z pogledom inštrumentov -->
            
                <ColumnDefinition Width="*"/>
            
                <!-- GLAVNA VSEBIBA -->
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="40" />
                <!-- PROSTOR ZA PLAY... GUMBE -->
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
                <!-- INSTRUMENT ROLL PROSTOR-->
            </Grid.RowDefinitions>


            <Image Margin="5,1,1,1"  Source="images/icons/vinyl_record_white.png" Width="35" Height="35" VerticalAlignment="Center" Grid.Column="0" HorizontalAlignment="Left"/>

        
            
            <!--ALTERNATIVNI GUMB ZA NASTAVITVE-->
            <!--<Button Name="SettingsButton" Width="35" Height="35" VerticalAlignment="Top" 
                Margin="3,1,1,1" HorizontalAlignment="Left" Click="settingsButton_click"
                Background="Transparent" Grid.Column="0" BorderBrush="Transparent" Grid.Row="1" ToolTip="Nastavitve" >
            
                <Image Source="images/icons/setting_cog.png" Width="30" Height="30"/>
            
            </Button>-->


            <!-- OSNOVNI GUMBI -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="btnMinimize" Content="_" Width="40" Height="40" BorderBrush="Transparent" Background="Transparent"  Foreground="White" Click="btnMinimize_Click"/>
                <Button Name="btnMaximize" Content="🗖" Width="40" Height="40" BorderBrush="Transparent" Background="Transparent" Click="btnMaximize_Click" Foreground="White"/>
                <Button Name="btnClose" Content="X" Width="40" Height="40" BorderBrush="Transparent" Background="Transparent" Click="btnClose_Click" Foreground="White"/>
            </StackPanel>


            <!-- GLAVNI GUMBI NA VRHU -->
            <StackPanel Orientation="Horizontal"  Background="#333333" VerticalAlignment="Top" Grid.Row="1" Grid.ColumnSpan="3" Height="37" HorizontalAlignment="Center">


                <Button Name="PlayButton" Width="100" Height="35" VerticalAlignment="Top" 
                Margin="20,0,20,0" HorizontalAlignment="Left" Click="PlayButton_Click"
                Background="Transparent" Style="{StaticResource RoundedButtonStyle}" ToolTip="Play all tracks">
                    <Image Source="images/icons/play_button_green.png" Width="24" Height="24"/> 
                </Button>
                <Button Name="PlaySoloButton" Width="100" Height="35" VerticalAlignment="Top" 
                Margin="10,0,20,0" HorizontalAlignment="Left" Click="playSoloButton_click"
                Background="Transparent" Style="{StaticResource RoundedButtonStyle}" ToolTip="Solo play current track">
                    <Image Source="images/icons/play_solo_button_green.png" Width="24" Height="24"/>
                </Button>


                <Button Width="100" Height="35" VerticalAlignment="Top" Click="ClearButton_Click" HorizontalAlignment="Right" Foreground="White" Margin="10,0,20,0" Background="Transparent" Style="{StaticResource RoundedButtonStyle}" ToolTip="Clear track">
                    <Image Source="/images/icons/clear_track_red.png" Width="24" Height="24"/>
                </Button>

                <Border Margin="40,0,0,0" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="8,4,8,4" VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal" Margin="0" VerticalAlignment="Center">

                        <ToggleButton Height="25" x:Name="SlowButton" Foreground="White" Content="Počasna" Width="60" Margin="0,0,5,0"
                          Style="{StaticResource RoundedToggleButtonStyle}" Background="Transparent"
                          BorderBrush="Transparent" Checked="SpeedButton_Checked" Tag="600"/>

                        <ToggleButton Height="25" x:Name="MediumButton" Foreground="White" Content="Srednja" Width="60" Margin="0,0,5,0"
                          Style="{StaticResource RoundedToggleButtonStyle}" Background="Transparent"
                          BorderBrush="Transparent" Checked="SpeedButton_Checked" Tag="300"/>

                        <ToggleButton Height="25"  x:Name="FastButton" Foreground="White" Content="Hitra" Width="60" Background="Transparent"
                          BorderBrush="Transparent" Style="{StaticResource RoundedToggleButtonStyle}"
                          Checked="SpeedButton_Checked" Tag="150"/>

                        <TextBlock x:Name="BpmLabel" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>

                    </StackPanel>
                </Border>

                <!--<Button Name="SaveButton" Width="100" Height="35" VerticalAlignment="Top" 
                Margin="20,0,20,0" HorizontalAlignment="Left" Click="SaveButton_Click"
                Background="Transparent" Style="{StaticResource RoundedButtonStyle}" ToolTip="Play all tracks" Content="Shrani" Foreground="White">
                </Button>

                <Button Name="LoadButton" Width="100" Height="35" VerticalAlignment="Top" 
                Margin="20,0,20,0" HorizontalAlignment="Left" Click="LoadButton_Click"
                Background="Transparent" Style="{StaticResource RoundedButtonStyle}" ToolTip="Play all tracks" Content="Nalozi" Foreground="White">
                </Button>-->
                
            </StackPanel>


            <Expander Header="Meni" Foreground="White" Background="#4f4f4f" ExpandDirection="Right" Grid.Row="2" Grid.Column="0" BorderThickness="0">
                <StackPanel Width="250">

                    <Button Height="40" Background="Transparent" Foreground="White" Click="AddSoundtrack_Click" Style="{StaticResource RoundedButtonStyle}" Margin="5,5,5,5">
                        <StackPanel Orientation="Horizontal">
                        
                            <TextBlock Margin="5,3,0,0" Text="Dodaj novo zvočno sled" />
                            <Image Margin="5,0,5,0"  Source="/images/icons/add_soundtrack_green.png" Width="24" Height="24"/>

                        </StackPanel>
                    </Button>

                    <StackPanel x:Name="TrackListPanel" />
                </StackPanel>
            </Expander>



        
                <!-- Instrument roll -->

            <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <!--probni gumbi-->
                    <ColumnDefinition Width="80"/>
                    <!--prazen prostor med probnimi gumbi in rolo-->
                    <ColumnDefinition Width="auto"/>
                    <!-- prostor za inštrument -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--probni gumbi-->
                <ItemsControl ItemsSource="{Binding SampleButtons}" Grid.Column="0" Margin="4,0,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="{Binding Rows}" Columns="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Padding="13" FontSize="14"
                        Style="{StaticResource RoundedButtonStyle}"
                        Content="{Binding DisplayName}" 
                        Command="{Binding DataContext.PlaySampleNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                        CommandParameter="{Binding}" 
                        Background="{Binding ButtonColor}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Column="1" Width="3" Margin="0" Background="Transparent"/>

                <!-- inštrument roll -->
                <ItemsControl ItemsSource="{Binding InstrumentKeys}" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="{Binding Rows}"
                                     Columns="{Binding Columns}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    
                    <DataTemplate>
                            <ToggleButton Style="{StaticResource RoundedToggleButtonStyle}" 
                                          Content="{Binding DisplayName}"
                              IsChecked="{Binding IsToggled, Mode=TwoWay}" 
                              Command="{Binding DataContext.PlayNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"
                              Background="{Binding ButtonColor}" 
                              Checked="ToggleButton_Checked"
                              PreviewMouseRightButtonDown="ToggleButton_PreviewMouseRightButtonDown"
                              PreviewMouseMove="ToggleButton_PreviewMouseMove"
                              PreviewMouseRightButtonUp="ToggleButton_PreviewMouseRightButtonUp" />

                    </DataTemplate>
                    
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                
                <TextBlock x:Name="EmptyStateText"
           Text="Trenutno v vašem projektu ni nobenih zvočnih sledi. Naložite projekt ali ustvarite novo zvočno sled.  &#x0a; &#x0a; ( Novo zvočno sled lahko dodate s pomočjo menija, ali pa pritisnite ctrl+t za izbiro inštrumenta )"
           Foreground="#99FFFFFF"
           FontSize="18"
           TextAlignment="Center"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           TextWrapping="Wrap"
           MaxWidth="500"
           
           IsHitTestVisible="False"
           Grid.ColumnSpan="3"/>
                <!--Visibility="Collapsed"-->

            </Grid>
        
            <!-- barvanje ozadnja spodnjih vrstic -->
            
            <Rectangle Grid.Row="3" Grid.Column="0" Fill="#4f4f4f"/>
            <Rectangle Grid.Row="3" Grid.Column="1" Fill="#4f4f4f"/>
            <Rectangle Grid.Row="3" Grid.Column="2" Fill="#4f4f4f"/>
            <ProgressBar Grid.Row="3" Grid.Column="2" x:Name="LoadingBar"
                 Minimum="0"
                 Maximum="100"
                 Height="10"
                 Value="0"
                 Visibility="Collapsed"
                 Margin="10"
                 VerticalAlignment="Bottom"/>


        </Grid>

        <!-- Gumb za nastavitve, generiran na koncu zato da ni pod vplivom grid strukture osnovnega "grid"-a ter expander ne vpliva nanj -->
        <Button
        Width="80" Height="30"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="50,5,0,0"
        Background="Transparent" Foreground="White" BorderBrush="Transparent" Click="settingsButton_click" >
            <TextBlock>
                Nastavitve
            </TextBlock>
        </Button>
        
        <Button
        Width="50" Height="30"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="130,5,0,0"
        Background="Transparent" Foreground="White" BorderBrush="Transparent" Click="SaveButton_Click">
            <TextBlock>
                Shrani
            </TextBlock>
        </Button>

        <Button

        Width="55" Height="30"
        HorizontalAlignment="Left"
        VerticalAlignment="Top"
        Margin="180,5,0,0"
        Background="Transparent" Foreground="White" BorderBrush="Transparent" Click="LoadButton_Click">
            <TextBlock>
                Naloži
            </TextBlock>
        </Button>


    </Grid>



</Window>
