<Window x:Class="xamlPianoRoll.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:xamlPianoRoll"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d" Background="#333333" WindowStyle="None" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Title="MainWindow" Height="720" Width="1280">
    <Window.Resources>
        <local:BlackToBackgroundCOnverter x:Key="BlackKeyConverter" />
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="35" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Padding" Value="5,0,5,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0"/>
    </WindowChrome.WindowChrome>
    
    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <!-- For the Expander Menu -->
            <ColumnDefinition Width="*"/>
            <!-- For the Main Content -->
        </Grid.ColumnDefinitions>

        <!-- Define Rows -->
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="40" />
            <!-- Row for the buttons -->
            <RowDefinition Height="*" />
            <!-- Row for the piano roll (takes the remaining space) -->
        </Grid.RowDefinitions>


        <Image Source="B:\xamlPianoRoll\xamlPianoRoll\images\ZvokarnaWhiteLogo2.png" Width="40" Height="40" VerticalAlignment="Center" Grid.Column="0" HorizontalAlignment="Left"/>

        <!-- OSNOVNI GUMBI -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="btnMinimize" Content="_" Width="40" Height="40" BorderBrush="Transparent" Background="Transparent"  Foreground="White" Click="btnMinimize_Click"/>
            <Button Name="btnMaximize" Content="🗖" Width="40" Height="40" BorderBrush="Transparent" Background="Transparent" Click="btnMaximize_Click" Foreground="White"/>
            <Button Name="btnClose" Content="X" Width="40" Height="40" BorderBrush="Transparent" Background="Transparent" Click="btnClose_Click" Foreground="White"/>
        </StackPanel>


        <!-- Black at top with buttons-->
        <StackPanel Orientation="Horizontal"  Background="#333333" VerticalAlignment="Top" Grid.Row="1" Grid.ColumnSpan="3" Height="37">

            <Button Content="Piano" Width="100" Height="35" VerticalAlignment="Top" Click="PianoButton_Click" Margin="40,0,20,0" Background="Transparent" Foreground="White" />
            <Button Content="Marimba" Width="100" Height="35" VerticalAlignment="Top" Click="MarimbaButton_Click" Margin="0,0,20,0" Background="Transparent" Foreground="White" />
            <Button Name="PlayButton" Content="Play" Width="100" Height="35" VerticalAlignment="Top" Margin="0,0,10,0" HorizontalAlignment="Left" Click="PlayButton_Click" Background="Transparent" Foreground="White"/>

            <!-- ComboBox for takt number -->
            <Label Content="Št. taktov:" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White" Background="Transparent" />
            <ComboBox x:Name="ComboTakt" SelectedIndex="0" Foreground="Black" Background="Transparent">
                <ComboBoxItem>4</ComboBoxItem>
                <ComboBoxItem>6</ComboBoxItem>
                <ComboBoxItem>8</ComboBoxItem>
                <ComboBoxItem>10</ComboBoxItem>
            </ComboBox>

            <!-- ComboBox for notes per takt -->
            <Label Content="Note na takt:" FontSize="20" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="White" Background="Transparent"/>
            <ComboBox x:Name="ComboNote" SelectedIndex="0" Foreground="Black">
                <ComboBoxItem>3</ComboBoxItem>
                <ComboBoxItem>4</ComboBoxItem>
                <ComboBoxItem>6</ComboBoxItem>
                <ComboBoxItem>8</ComboBoxItem>
            </ComboBox>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Margin="20,0,0,0" Text="BPM: " Height="35" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" Background="Transparent"/>
                <xctk:IntegerUpDown Minimum="30" Maximum="240" Value="{Binding BPM, Mode=TwoWay}" FontSize="16" Width="80" Margin="0,0,20,0" Foreground="White" Background="Transparent"/>
            </StackPanel>

            <Button Content="Clear" Width="100" Height="35" VerticalAlignment="Top" Click="ClearButton_Click" HorizontalAlignment="Right" Foreground="White" Background="Transparent"/>

        </StackPanel>


        <Expander Header="Meni" Foreground="White" Background="#4f4f4f" ExpandDirection="Right" Grid.Row="2" Grid.Column="0" BorderThickness="0">
            <StackPanel Width="250">

                <Button Height="40" Background="Transparent" Foreground="White" Click="AddSoundtrack_Click">
                    <StackPanel Orientation="Horizontal">
                        
                        <TextBlock Text="Dodaj novo zvočno sled" />
                        <TextBlock Text="🎵" FontSize="14" Margin="5,0,5,0"/>

                    </StackPanel>
                </Button>

            </StackPanel>
        </Expander>



            <!-- Piano Roll (ItemsControl in Row 1) -->
        <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,0">
            <ItemsControl ItemsSource="{Binding PianoKeys}" Grid.Row="1" Grid.ColumnSpan="3">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="{Binding Rows}"
                                 Columns="{Binding Columns}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ToggleButton Content="{Binding DisplayName}"
                          IsChecked="{Binding IsToggled, Mode=TwoWay}" 
                          Command="{Binding DataContext.PlayNoteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"
                          Background="{Binding ButtonColor}" 
                          Checked="ToggleButton_Checked"
                          PreviewMouseRightButtonDown="ToggleButton_PreviewMouseRightButtonDown"
                          PreviewMouseMove="ToggleButton_PreviewMouseMove"
                          PreviewMouseRightButtonUp="ToggleButton_PreviewMouseRightButtonUp" />

                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Grid>
    </Grid>
</Window>
